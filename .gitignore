# --- Большие регенерируемые данные ---
# декомпиляция (scripts/decompile_apks.py из original_apks/)
decompiled/
# извлечение строк (extract_cjk.py)
extracted/
# исходные APK-и прошивки (~5.3G)
original_apks/
# генерируемые оверлеи (generate_overlays*.py)
overlays/
overlays_static/
# временные папки сборки
overlay_build/
overlay_build_static/
# собранные RRO-APK
apks_rro_min/
apks_rro_static/

# --- БД (derive: create_db.py) ---
database/

# --- Логи / артефакты сессий ---
logs/
__pycache__/
*.pyc

# --- Windows-бэкапы / временные файлы ---
*.bak
*.orig
*.tmp
~$*

# --- Бинарные тулзы (deepl/shot, linux+win) ---
# Не храним в git: собираются `bash build_go.sh` из исходников
# (go/ — deepl, logshot/ — shot); в релиз их кладёт build_release.sh с диска.
deepl
deepl.exe
shot
shot.exe
